# What this file does:
# This is the EXAMPLE version of the environment file.
# Developers copy this file to .env and fill in their real values.
# The real .env is gitignored and must NEVER be committed.
# In AWS production, these values come from Secrets Manager and ECS task definition environment variables.
# In local Docker Compose, these values come from .env files per service.

# =====================
# Auth Service
# =====================
AUTH_PORT=3001
AUTH_NODE_ENV=local

# JWT_SECRET is the key used to sign and verify JSON Web Tokens.
# In production, this comes from AWS Secrets Manager (never hardcoded).
# For local dev, use any long random string.
AUTH_JWT_SECRET=replace_this_with_a_long_random_string_at_least_32_characters

# How long a token stays valid before the user must log in again.
AUTH_JWT_EXPIRES_IN=15m

# =====================
# Orders Service
# =====================
ORDERS_PORT=3002
ORDERS_NODE_ENV=local

# The URL the Orders service uses to call the Auth service.
# In AWS production this resolves through Cloud Map DNS to auth.project6.local:3001
# In local Docker Compose, the container name 'auth' acts as the hostname.
ORDERS_AUTH_SERVICE_URL=http://auth:3001

# The URL the Orders service uses to call the Notifications service.
# Same pattern as above.
ORDERS_NOTIFICATIONS_SERVICE_URL=http://notifications:3003

# INTERNAL_SERVICE_SECRET is a shared secret between internal services.
# The Orders service sends this in a header when calling Notifications.
# Notifications rejects any call that does not include this secret.
# In production, this comes from Secrets Manager.
ORDERS_INTERNAL_SERVICE_SECRET=replace_this_with_a_shared_internal_secret

# =====================
# Notifications Service
# =====================
NOTIFICATIONS_PORT=3003
NOTIFICATIONS_NODE_ENV=local
NOTIFICATIONS_INTERNAL_SERVICE_SECRET=replace_this_with_a_shared_internal_secret

# =====================
# Redis (shared across all services)
# =====================
REDIS_HOST=redis
REDIS_PORT=6379

# REDIS_PASSWORD is the password for the Redis instance.
# In production, ElastiCache Redis uses auth tokens.
# For local dev, leave empty (no password on the local Redis container).
REDIS_PASSWORD=

# =====================
# Log level
# =====================
# Options: trace, debug, info, warn, error, fatal
LOG_LEVEL=info
