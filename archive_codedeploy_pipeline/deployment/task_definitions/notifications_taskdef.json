{
  "family": "project6_notifications",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "containerDefinitions": [
    {
      "name": "notifications",
      "image": "<IMAGE_URI>",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3003,
          "hostPort": 3003,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "PORT", "value": "3003" },
        { "name": "NODE_ENV", "value": "production" },
        { "name": "SERVICE_NAME", "value": "notifications" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs_group": "/project6/notifications",
          "awslogs_region": "us_east_1",
          "awslogs_stream_prefix": "ecs"
        }
      }
    }
  ]
}
