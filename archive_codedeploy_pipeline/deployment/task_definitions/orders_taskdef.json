{
  "family": "project6_orders",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "containerDefinitions": [
    {
      "name": "orders",
      "image": "<IMAGE_URI>",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3002,
          "hostPort": 3002,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "PORT", "value": "3002" },
        { "name": "NODE_ENV", "value": "production" },
        { "name": "SERVICE_NAME", "value": "orders" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs_group": "/project6/orders",
          "awslogs_region": "us_east_1",
          "awslogs_stream_prefix": "ecs"
        }
      }
    }
  ]
}
