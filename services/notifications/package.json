{
  "name": "notifications_service",
  "version": "1.0.0",
  "description": "Notifications microservice for AWS Project 6. Receives internal notifications via Cloud Map DNS.",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p .",
    "test": "jest --runInBand --forceExit",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "aws-xray-sdk": "^3.9.0",
    "express": "^4.18.2",
    "ioredis": "^5.3.2",
    "pino": "^8.15.0",
    "pino-http": "^8.5.0",
    "uuid": "^9.0.0",
    "zod": "^3.22.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.0",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2"
  }
